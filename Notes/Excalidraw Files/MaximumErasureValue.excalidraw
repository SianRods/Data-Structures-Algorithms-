    {
      "id": "cUALHhmtIpyah3uO2zjz_",
      "type": "text",
      "x": 402.57761528235517,
      "y": 173.19998162634224,
      "width": 1057.055419921875,
      "height": 54.624485234249256,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
