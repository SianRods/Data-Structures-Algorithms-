      "index": "bK2",
      "roundness": null,
      "seed": 1963992418,
      "version": 528,
      "versionNonce": 1352832638,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753164654547,
      "link": null,
      "locked": false,
      "text": "Here we have to delete exactly one subarray with all unique elements and return the sum \nof all the deleted elements of that subarray ",
      "fontSize": 21.849794093699703,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we have to delete exactly one subarray with all unique elements and return the sum \nof all the deleted elements of that subarray ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Lwz0YR_s-YTyu6gjlcKgO",
      "type": "text",
      "x": 561.2438085776552,
      "y": 670.2188222203988,
      "width": 442.71815683943663,
      "height": 59.18691936356102,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
