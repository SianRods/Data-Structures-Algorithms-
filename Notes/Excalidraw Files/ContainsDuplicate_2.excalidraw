      "updated": 1752911404922,
      "link": null,
      "locked": false,
      "text": "Given an integer array nums and an integer k, return true if there are two distinct indices i and j in the array \nsuch that nums[i] == nums[j] and abs(i - j) <= k.",
      "fontSize": 25.08010023262692,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Given an integer array nums and an integer k, return true if there are two distinct indices i and j in the array \nsuch that nums[i] == nums[j] and abs(i - j) <= k.",
      "autoResize": true,
      "lineHeight": 1.25
    },
