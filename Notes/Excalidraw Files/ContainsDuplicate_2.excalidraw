    {
      "id": "pHenif4X1xkogQbLbpS2B",
      "type": "text",
      "x": 318.74269571735715,
      "y": 503.083992327406,
      "width": 1146.1641845703125,
      "height": 52.93074678900638,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGb",
      "roundness": null,
      "seed": 506311990,
      "version": 468,
      "versionNonce": 1039940330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752911445460,
      "link": null,
      "locked": false,
      "text": "Optimized Solution using Sliding window and set approach . Here we will initialize the Starting window and then \nwould keep on shifting the fixed size window by one till j<=n or we find the duplicate ",
      "fontSize": 21.17229871560255,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optimized Solution using Sliding window and set approach . Here we will initialize the Starting window and then \nwould keep on shifting the fixed size window by one till j<=n or we find the duplicate ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IdCISYx6pW2DM5_zE1zpb",
      "type": "text",
      "x": 334.8354979991471,
      "y": 614.2111755992656,
      "width": 352.9397277832031,
      "height": 125,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGf",
      "roundness": null,
      "seed": 1883341738,
      "version": 204,
      "versionNonce": 2017710582,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752911525377,
      "link": null,
      "locked": false,
      "text": "//Initialize the starting window\nwhile(j<=k && j<n){\n    if(set.contains(n[j])) return true\n    else set.add(n[j])\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//Initialize the starting window\nwhile(j<=k && j<n){\n    if(set.contains(n[j])) return true\n    else set.add(n[j])\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yq9uTA9CULgKBdmsNxydE",
      "type": "text",
      "x": 965.8281102810633,
      "y": 608.8380714958269,
      "width": 357.3997497558594,
      "height": 175,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGg",
      "roundness": null,
      "seed": 1583181354,
      "version": 193,
      "versionNonce": 1612781866,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752911612685,
      "link": null,
      "locked": false,
      "text": "//Sliding the window now\nwhile(j<=n){\n   set.remove(n[ i ]);\n   if(set.contains(n[ j ]) return truel\n   else:\n        set.add(n[j])\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//Sliding the window now\nwhile(j<=n){\n   set.remove(n[ i ]);\n   if(set.contains(n[ j ]) return truel\n   else:\n        set.add(n[j])\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
