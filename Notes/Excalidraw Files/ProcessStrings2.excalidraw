      "link": null,
      "locked": false,
      "text": "len  => total length of the 'result' string after processing all the characters in the string\n\nk>=len || k<0 => return '.'\n\nelse : we will have to process the string from backside using simulation to get the kth character of the \nString until and unless we find a lowercase english letter\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "len  => total length of the 'result' string after processing all the characters in the string\n\nk>=len || k<0 => return '.'\n\nelse : we will have to process the string from backside using simulation to get the kth character of the \nString until and unless we find a lowercase english letter\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
