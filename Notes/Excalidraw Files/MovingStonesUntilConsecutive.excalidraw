      "isDeleted": false,
      "boundElements": null,
      "updated": 1753640757645,
      "link": null,
      "locked": false,
      "text": "Algorithm for Finding the MaxMoves && MinMoves \n\nif(rangeLeft==0 && rangeRight==0)minsMoves=0;\nif(rangeLeft<=1 || rangeRight<=1)minMoves =1; \n// As we can always move the one with more gap to the one with 1 gap in single move\n\nelse {\n    minMoves=2;\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm for Finding the MaxMoves && MinMoves \n\nif(rangeLeft==0 && rangeRight==0)minsMoves=0;\nif(rangeLeft<=1 || rangeRight<=1)minMoves =1; \n// As we can always move the one with more gap to the one with 1 gap in single move\n\nelse {\n    minMoves=2;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    }
