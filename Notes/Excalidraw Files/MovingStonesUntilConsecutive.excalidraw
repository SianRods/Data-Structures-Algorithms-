    },
    {
      "id": "_VZr2zA8k89j8bnSPjnE0",
      "type": "text",
      "x": 1258.3426308621865,
      "y": 1037.2252843437716,
      "width": 1416.398448610945,
      "height": 88.5987353176154,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQ5",
      "roundness": null,
      "seed": 1597021037,
      "version": 662,
      "versionNonce": 37758701,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753640775759,
      "link": null,
      "locked": false,
      "text": "If Right Range = 1 Then In order to obtain a consecutive seq where middle at start (I can only make one move)\nIf Right Range = 2 Then in order to obtain '' We can shift the min to mid+1 and max the the rightmost side\nIf Right Range > 2 Then the minimum Number of Moves will always remain 2 as we can repeat the above steps",
      "fontSize": 23.62632941803077,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If Right Range = 1 Then In order to obtain a consecutive seq where middle at start (I can only make one move)\nIf Right Range = 2 Then in order to obtain '' We can shift the min to mid+1 and max the the rightmost side\nIf Right Range > 2 Then the minimum Number of Moves will always remain 2 as we can repeat the above steps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AJZrJ6cJnFkhiLVnwbNOU",
      "type": "text",
      "x": 1245.948606655294,
      "y": 1162.4140280075503,
      "width": 1487.1892810575014,
      "height": 54.07961022027279,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQ6",
      "roundness": null,
      "seed": 2093613443,
      "version": 654,
      "versionNonce": 587466573,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753640778973,
      "link": null,
      "locked": false,
      "text": "If we are considering to place the middle element at the middle position itself the maximum moves required will \nalways be 2 to shift leftmost element to mid-1 and to shift the right most max element to mid+1 if they are not there already",
      "fontSize": 21.631844088109105,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we are considering to place the middle element at the middle position itself the maximum moves required will \nalways be 2 to shift leftmost element to mid-1 and to shift the right most max element to mid+1 if they are not there already",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6BhEoLXEVSi4ol8vyxqq8",
      "type": "text",
      "x": 1249.0717811607808,
      "y": 1252.986236957487,
      "width": 1446.4832818555685,
      "height": 91.31838900603337,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQ7",
      "roundness": null,
      "seed": 310304653,
      "version": 793,
      "versionNonce": 710049379,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753640781299,
      "link": null,
      "locked": false,
      "text": "If Left Range = 1 Then In order to obtain a consecutive seq where middle at start (I can only make one move)\nIf Left Range = 2 Then in order to obtain '' We can shift the maximum to mid-1 and min to the leftmost side\nIf Left Range > 2 Then the minimum Number of Moves will always remain 2 as we can repeat the above steps",
      "fontSize": 24.351570401608903,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If Left Range = 1 Then In order to obtain a consecutive seq where middle at start (I can only make one move)\nIf Left Range = 2 Then in order to obtain '' We can shift the maximum to mid-1 and min to the leftmost side\nIf Left Range > 2 Then the minimum Number of Moves will always remain 2 as we can repeat the above steps",
      "autoResize": true,
      "lineHeight": 1.25
    },
