      "text": "For a given middle Number there are at most 3 Consecutive sequences which are possible\n\n1]middle is at start\n2]middle is at middle \n3]middle is at end   ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For a given middle Number there are at most 3 Consecutive sequences which are possible\n\n1]middle is at start\n2]middle is at middle \n3]middle is at end   ",
      "autoResize": true,
      "lineHeight": 1.25
    },
