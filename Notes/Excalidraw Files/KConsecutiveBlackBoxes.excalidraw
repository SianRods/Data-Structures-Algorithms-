    {
      "id": "W4zTemIDlmGvYD5xOVZyR",
      "type": "text",
      "x": 477.13695379412525,
      "y": 261.18904884939275,
      "width": 563.6387748227664,
      "height": 649.6747822678869,
      "angle": 0,
