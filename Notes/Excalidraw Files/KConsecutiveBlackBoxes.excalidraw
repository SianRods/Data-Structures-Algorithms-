      "index": "bQv",
      "roundness": null,
      "seed": 2114349621,
      "version": 423,
      "versionNonce": 947770683,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753789439030,
      "link": null,
      "locked": false,
      "text": " public static int minimumRecolors(String blocks, int k) {\n        int i = 0;\n        int j = 0;\n        int n = blocks.length();\n        int countWhite = 0;\n        int minOps = 0;\n\n        // Initialize the starting window\n        while (j < n && j < k) {\n            if (blocks.charAt(j) == 'W')\n                countWhite++;\n            j++;\n        }\n\n        minOps = countWhite;\n        while (j < n) {\n            if (blocks.charAt(j) == 'W')\n                countWhite++;\n\n            if (j - i == k) {\n                minOps = Math.min(countWhite, minOps);\n            }\n\n            if (blocks.charAt(i) == 'W')\n                countWhite--;\n            i++;\n            j++;\n\n        }\n\n        return minOps;\n    }",
      "fontSize": 16.24186955669718,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " public static int minimumRecolors(String blocks, int k) {\n        int i = 0;\n        int j = 0;\n        int n = blocks.length();\n        int countWhite = 0;\n        int minOps = 0;\n\n        // Initialize the starting window\n        while (j < n && j < k) {\n            if (blocks.charAt(j) == 'W')\n                countWhite++;\n            j++;\n        }\n\n        minOps = countWhite;\n        while (j < n) {\n            if (blocks.charAt(j) == 'W')\n                countWhite++;\n\n            if (j - i == k) {\n                minOps = Math.min(countWhite, minOps);\n            }\n\n            if (blocks.charAt(i) == 'W')\n                countWhite--;\n            i++;\n            j++;\n\n        }\n\n        return minOps;\n    }",
      "autoResize": false,
      "lineHeight": 1.25
    }
