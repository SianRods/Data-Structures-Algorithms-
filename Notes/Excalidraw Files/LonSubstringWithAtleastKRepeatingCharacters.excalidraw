      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJX",
      "roundness": null,
      "seed": 2132483477,
      "version": 936,
      "versionNonce": 1679866197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753082005566,
      "link": null,
      "locked": false,
      "text": "Here we simply use Hashmap to keep track of all the characters with their frequencies in the string \nthe for those characters with frequency < k we find the their occurrence in the string and divide the \nstring into subparts about that particular index and return the Math.max(left,right);\n**Here we divide only into parts by considering the first occurrence of the less freq character \n\nThe base condition for this recursive solutions is obv when the length of the string becomes == 0\nin such cases that particular substring in that particular call can't be a solution so it returns=0      \n",
      "fontSize": 33.771018113283844,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we simply use Hashmap to keep track of all the characters with their frequencies in the string \nthe for those characters with frequency < k we find the their occurrence in the string and divide the \nstring into subparts about that particular index and return the Math.max(left,right);\n**Here we divide only into parts by considering the first occurrence of the less freq character \n\nThe base condition for this recursive solutions is obv when the length of the string becomes == 0\nin such cases that particular substring in that particular call can't be a solution so it returns=0      \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
