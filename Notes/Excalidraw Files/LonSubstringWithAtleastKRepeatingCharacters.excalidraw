    {
      "id": "XrqMO3_y8A6ufIFdQEt-U",
      "type": "text",
      "x": 1035.9705357019348,
      "y": 1324.4472328044621,
      "width": 1723.7100058852836,
      "height": 101.31526267756095,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
