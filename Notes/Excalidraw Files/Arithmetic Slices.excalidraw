      "link": null,
      "locked": false,
      "text": "Subarrays with length(len)=\n(len-2)*(len-1)/2;\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "OtHWR6QifzDy46lzBs5-r",
      "originalText": "Subarrays with length(len)=\n(len-2)*(len-1)/2;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
