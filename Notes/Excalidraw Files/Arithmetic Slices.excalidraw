    {
      "id": "YpMpt99P04jfQNS-0MiOI",
      "type": "text",
      "x": 1301.9965142302224,
      "y": 300.6919991115713,
      "width": 554.3997802734375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
