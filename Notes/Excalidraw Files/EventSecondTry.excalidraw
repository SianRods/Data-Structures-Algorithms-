    },
    {
      "id": "S0oRi8dIMjiWiZlALZ0pU",
      "type": "text",
      "x": 1452.4800969970072,
      "y": 1192.3241989543649,
      "width": 1605.845458984375,
      "height": 157.3657731047677,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAp",
      "roundness": null,
      "seed": 2042213183,
      "version": 484,
      "versionNonce": 427061759,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752257574427,
      "link": null,
      "locked": false,
      "text": "Here we have to find a way in order to combine both the gaps g1 and g2 so as to maximize the free space \nand in order to combine this gaps we can either shift E1 to right or left side . \n\nSo for a given value of k (max no of meetings which can be shifted ) so we have to consider k+1 gaps as \na given meeting can be shifted to either of it's vicinity (left or right so as to maximize the combination of gaps )",
      "fontSize": 25.17852369676283,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we have to find a way in order to combine both the gaps g1 and g2 so as to maximize the free space \nand in order to combine this gaps we can either shift E1 to right or left side . \n\nSo for a given value of k (max no of meetings which can be shifted ) so we have to consider k+1 gaps as \na given meeting can be shifted to either of it's vicinity (left or right so as to maximize the combination of gaps )",
      "autoResize": true,
      "lineHeight": 1.25
    },
