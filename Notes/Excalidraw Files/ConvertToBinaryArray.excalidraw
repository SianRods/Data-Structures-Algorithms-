    {
      "id": "9k8dvDAP9qBcjm_FegoVt",
      "type": "text",
      "x": 1290.7712838309153,
      "y": 362.88513355121137,
      "width": 439.23556191580616,
      "height": 360.0291491113166,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQO",
      "roundness": null,
      "seed": 83447050,
      "version": 558,
      "versionNonce": 1667325035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753725782067,
      "link": null,
      "locked": false,
      "text": "\n        while (i < n - 2) {\n\n            if (nums[i] == 0) {\n                ops++;\n                nums[i] = 1 - nums[i];\n                nums[i + 1] = 1 - nums[i + 1];\n                nums[i + 2] = 1 - nums[i + 2];\n            }\n            while (i < n - 2 && nums[i] != 0) {\n                i++;\n            }\n\n            \n        }\n\n        // Checking if there exists any 0 in the array or not\n        for (; j < n; j++) {\n            if (nums[j] == 0)\n                return -1;\n        }\n        return ops;",
      "fontSize": 13.091969058593328,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n        while (i < n - 2) {\n\n            if (nums[i] == 0) {\n                ops++;\n                nums[i] = 1 - nums[i];\n                nums[i + 1] = 1 - nums[i + 1];\n                nums[i + 2] = 1 - nums[i + 2];\n            }\n            while (i < n - 2 && nums[i] != 0) {\n                i++;\n            }\n\n            \n        }\n\n        // Checking if there exists any 0 in the array or not\n        for (; j < n; j++) {\n            if (nums[j] == 0)\n                return -1;\n        }\n        return ops;",
      "autoResize": true,
      "lineHeight": 1.25
    }
