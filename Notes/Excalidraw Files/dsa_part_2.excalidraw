      "isDeleted": false,
      "boundElements": [],
      "updated": 1781674300235,
      "link": null,
      "locked": false,
      "text": "input == x \nIf ‘n’ is not a perfect square, then return the floor value of sqrt(n).",
      "fontSize": 25.640149319551835,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "input == x \nIf ‘n’ is not a perfect square, then return the floor value of sqrt(n).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0XyNl-L84-xgtkrY27f0T",
      "type": "text",
      "x": 1747.4799102739612,
      "y": 275.47107219888153,
      "width": 985.5997314453125,
      "height": 35,
