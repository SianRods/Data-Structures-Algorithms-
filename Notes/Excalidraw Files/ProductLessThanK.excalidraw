    {
      "id": "OCoOsiRQAb4jIOFQ2Yqxc",
      "type": "text",
      "x": -129.25629530309072,
      "y": 40.26618104262499,
      "width": 316.3553568192157,
      "height": 701.0156835562561,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMZ",
      "roundness": null,
      "seed": 1324334343,
      "version": 477,
      "versionNonce": 2099282375,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753280160026,
      "link": null,
      "locked": false,
      "text": "Sample Code :\n if (k <= 0)\n            return 0;\n\n        int i = 0;\n        int j = 0;\n        int count = 0;\n        int n = nums.length;\n        int prod = 1;\n\n        while (i < n && nums[i] >= k) {\n            i++;\n            j++;\n        }\n\n        while (j < n) {\n            while (j < n) {\n                prod *= nums[j];\n                if (prod >= k)\n                    break;\n                j++;\n            }\n\n            if (j > i) {\n\n                int len = j - i;\n                count += len + len - 1;\n            }\n\n            while (i < j && prod >= k) {\n                prod /= nums[i];\n\n                i++;\n            }\n\n        }\n\n        return count;\n",
      "fontSize": 14.379808893461657,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sample Code :\n if (k <= 0)\n            return 0;\n\n        int i = 0;\n        int j = 0;\n        int count = 0;\n        int n = nums.length;\n        int prod = 1;\n\n        while (i < n && nums[i] >= k) {\n            i++;\n            j++;\n        }\n\n        while (j < n) {\n            while (j < n) {\n                prod *= nums[j];\n                if (prod >= k)\n                    break;\n                j++;\n            }\n\n            if (j > i) {\n\n                int len = j - i;\n                count += len + len - 1;\n            }\n\n            while (i < j && prod >= k) {\n                prod /= nums[i];\n\n                i++;\n            }\n\n        }\n\n        return count;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
