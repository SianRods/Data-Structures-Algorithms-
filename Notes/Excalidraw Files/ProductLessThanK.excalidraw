    {
      "id": "uefvkmfF7Ma6Qiq4UUhTR",
      "type": "text",
      "x": 619.7999877929688,
      "y": 732.3999938964844,
      "width": 250.27196777343755,
      "height": 47.399993896484396,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
