    {
      "id": "g92nvNXeRzsHkHmfAVyb0",
      "type": "text",
      "x": -1267.4475937305936,
      "y": 1671.8340467337352,
      "width": 714.8292846679688,
      "height": 670.5652394656399,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "uJmgdO7uGXrQgw0ERsV3f",
      "index": "bU1",
      "roundness": null,
      "seed": 726506013,
      "version": 1682,
      "versionNonce": 1842394280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753857534313,
      "link": null,
      "locked": false,
      "text": "private Node insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    \n    //Updating the height of the each node which is invoved in \n    addition of the new node \n    \nnode.height=Math.max(node.left.height,node.right.height)+1\n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "fontSize": 20.63277659894277,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "private Node insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    \n    //Updating the height of the each node which is invoved in \n    addition of the new node \n    \nnode.height=Math.max(node.left.height,node.right.height)+1\n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
