      "isDeleted": false,
      "boundElements": null,
      "updated": 1753862093720,
      "link": null,
      "locked": false,
      "text": "Here we will have to Perform a Right Rotation in order to Balance out the Tree Again",
      "fontSize": 16.78155241332333,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here we will have to Perform a Right Rotation in order to Balance out the Tree Again",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
