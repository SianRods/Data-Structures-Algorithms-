      "isDeleted": false,
      "boundElements": null,
      "updated": 1753862093720,
      "link": null,
      "locked": false,
      "text": "All the Rotations performed are such that after performing the rotation all the properties of the \nBinary Search Trees are preserved as well as the tree is balanced",
      "fontSize": 17.172239183867944,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "All the Rotations performed are such that after performing the rotation all the properties of the \nBinary Search Trees are preserved as well as the tree is balanced",
      "autoResize": true,
      "lineHeight": 1.25
    },
