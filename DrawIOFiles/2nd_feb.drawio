        <mxCell id="YkG0HKPUY__zJfFapxrO-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;div style=&quot;color: rgb(188, 190, 196); background-color: rgb(25, 26, 28); font-family: &amp;quot;Fira code&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;/**&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;* &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;font-style: italic;&quot;&gt;@param&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-style: italic;&quot;&gt;arr&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; &amp;nbsp; array to reverse&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;font-style: italic;&quot;&gt;@param&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-style: italic;&quot;&gt;start&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; starting bound of the array to reverse [Inclusive]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;font-style: italic;&quot;&gt;@param&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-style: italic;&quot;&gt;end&lt;/span&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt; &amp;nbsp; ending bounds of the array to reverse&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #5f826b;font-style: italic;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;*/&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #cf8e6d;&quot;&gt;public&lt;/span&gt; &lt;span style=&quot;color: #cf8e6d;&quot;&gt;static&lt;/span&gt; &lt;span style=&quot;color: #cf8e6d;&quot;&gt;void&lt;/span&gt; &lt;span style=&quot;color: #56a8f5;&quot;&gt;reverseWithinBounds&lt;/span&gt;(&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;arr[],&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;start,&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;end) {&lt;/div&gt;&lt;br&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt; temp = &lt;span style=&quot;color: #2aacb8;&quot;&gt;0&lt;/span&gt;;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;color: #cf8e6d;&quot;&gt;while&lt;/span&gt; (start &amp;lt; end) {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; temp = arr[start];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; arr[start] = arr[end];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; arr[end] = temp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; start++;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; end--;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;br&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="373" width="664" x="383" y="18" as="geometry" />
