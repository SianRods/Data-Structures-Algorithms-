        <mxCell id="zHAo5saJQe5RXw9YL8rr-191" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: #bcbec4;background-color: #191a1c;font-family: &#39;Fira code&#39;, Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;public&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;static&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;Integer&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;gt;&amp;gt; &lt;/span&gt;&lt;span style=&quot;color: #56a8f5;&quot;&gt;solution1&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #56a8f5;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;rows&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;Integer&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;gt;&amp;gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;sol&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;new&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;ArrayList&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&amp;gt;();&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;sol&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;add&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;new&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;ArrayList&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&amp;gt;(&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;font-style: italic;&quot;&gt;of&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #2aacb8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;)));&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;rows&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;--;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #7a7e85;&quot;&gt;// start from --&amp;gt; index i==1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; (&lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;color: #2aacb8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &amp;lt;= &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;rows&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;++) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;Integer&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;rowInsert&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;new&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;ArrayList&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&amp;gt;();&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;List&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;Integer&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;prevRow&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;sol&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;get&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; - &lt;/span&gt;&lt;span style=&quot;color: #2aacb8;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;for&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; (&lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; = &lt;/span&gt;&lt;span style=&quot;color: #2aacb8;&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; &amp;lt;= &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;; &lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;j&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;++) {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #cf8e6d;&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: #bcbec4;&quot;&gt; (&lt;/span&