    {
      "id": "g92nvNXeRzsHkHmfAVyb0",
      "type": "text",
      "x": -1236.2674138944076,
      "y": 225.83150270779151,
      "width": 714.6979238023854,
      "height": 670.5652394656404,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "uJmgdO7uGXrQgw0ERsV3f",
      "index": "bOP",
      "roundness": null,
      "seed": 726506013,
      "version": 1420,
      "versionNonce": 1998735958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753511044001,
      "link": null,
      "locked": false,
      "text": "public void insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    \n    //Updating the height of the each node which is invoved in \n    addition of the new node \n    \nnode.height=Math.max(node.left.height,node.right.height)+1\n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "fontSize": 20.63277659894277,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    \n    //Updating the height of the each node which is invoved in \n    addition of the new node \n    \nnode.height=Math.max(node.left.height,node.right.height)+1\n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
