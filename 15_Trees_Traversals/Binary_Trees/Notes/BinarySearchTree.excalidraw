    {
      "id": "g92nvNXeRzsHkHmfAVyb0",
      "type": "text",
      "x": 1091.90211584017,
      "y": 320.7550657125968,
      "width": 638,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOP",
      "roundness": null,
      "seed": 726506013,
      "version": 475,
      "versionNonce": 1225519059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753467063973,
      "link": null,
      "locked": false,
      "text": "public void insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void insert(Node node, int value){\n    \n    if(node == null){\n        return new Node(value);\n        }\n\n    if(value<node.getValue()){\n        \n        node.left=insert(node.left,value);\n       }\n\n     if(value>node.getValue()){\n        node.right=insert(node.right,value);\n        }    \n\n    // else preserving the old connections b/w valid nodes\n    return node;\n\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
